{
  "name": "tictactoe",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/client",
    "apps/server"
  ],
  "scripts": {
    "dev": "npm run dev -w @tictactoe/client",
    "host": "npm run dev -w @tictactoe/client -- --host",
    "build": "npm run build:client && npm run build:server",
    "build:client": "npm run build -w @tictactoe/client",
    "build:server": "npm run typecheck -w @tictactoe/server",
    "preview": "npm run preview -w @tictactoe/client",
    "test": "npm run test -w @tictactoe/client",
    "test:run": "npm run test:run -w @tictactoe/client",
    "server:dev": "npm run dev -w @tictactoe/server"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "ts-lit-plugin": "^2.0.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.0.16"
  },
  "description": "Ein nicht mehr ganz so simples TicTacToe-Spiel, das mittlerweile mehr Over-Engineering enthält als notwendig. Ursprünglich als kleines JS-Skript gestartet, ist es jetzt ein TypeScript-Projekt mit Architektur-Patterns, weil... warum nicht?",
  "main": "index.js",
  "directories": {
    "test": "tests"
  },
  "dependencies": {
    "assertion-error": "^2.0.1",
    "chai": "^6.2.2",
    "emoji-picker-element": "^1.29.1",
    "es-module-lexer": "^1.7.0",
    "esbuild": "^0.27.2",
    "estree-walker": "^3.0.3",
    "expect-type": "^1.3.0",
    "express": "^5.2.1",
    "fdir": "^6.5.0",
    "get-tsconfig": "^4.13.0",
    "lit": "^3.3.2",
    "magic-string": "^0.30.21",
    "nanoid": "^3.3.11",
    "obug": "^2.1.1",
    "pathe": "^2.0.3",
    "picocolors": "^1.1.1",
    "picomatch": "^4.0.3",
    "postcss": "^8.5.6",
    "resolve-pkg-maps": "^1.0.0",
    "rollup": "^4.54.0",
    "siginfo": "^2.0.0",
    "socket.io": "^4.8.3",
    "source-map-js": "^1.2.1",
    "stackback": "^0.0.2",
    "std-env": "^3.10.0",
    "tinybench": "^2.9.0",
    "tinyexec": "^1.0.2",
    "tinyglobby": "^0.2.15",
    "tinyrainbow": "^3.0.3",
    "why-is-node-running": "^2.3.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kaiyoKai/Tic-Tac-Toe.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/kaiyoKai/Tic-Tac-Toe/issues"
  },
  "homepage": "https://github.com/kaiyoKai/Tic-Tac-Toe#readme"
}
