import type { MoveStrategy } from "./MovesStrategy.ts";
import type TicTacToe from "../../core/TicTacToe.ts";
import type { Position } from "../../core/IPosition.ts";

export const ShortSightedStrategy: MoveStrategy = {
  determineMove(
    game: TicTacToe,
    mySymbol: string,
    allSymbols: string[] = ["X", "O"],
  ): { row: number; col: number } | undefined {
    type SymbolKey = (typeof allSymbols)[number];

    const validMoves = game.getValidMoves();
    if (validMoves.length === 0) return undefined;

    for (const move of validMoves) {
      const placesToBlock: Partial<Record<SymbolKey, Position[]>> = {};

      for (const currentSymbol of allSymbols) {
        game.board[move.row][move.col] = currentSymbol;
        const result = game.isFinished(move.row, move.col);

        game.board[move.row][move.col] = null;

        if (result) {
          if (currentSymbol === mySymbol) {
            return move;
          } else {
            (placesToBlock[currentSymbol] ??= []).push({
              row: move.row,
              col: move.col,
            });
          }
          const symbolsThatNeedBlocking = Object.keys(placesToBlock);

          if (symbolsThatNeedBlocking.length > 0) {
            const randomIndex = Math.floor(
              Math.random() * symbolsThatNeedBlocking.length,
            );
            const randomPlaceToBlock = symbolsThatNeedBlocking[randomIndex];

            console.log("Zufälliger Key:", randomPlaceToBlock ;
            console.log("Dazugehörige Positionen:", placesToBlock[randomPlaceToBlock]);
          }
        }
      }
    }

    const randomIndex = Math.floor(Math.random() * validMoves.length);
    return validMoves[randomIndex];
  },
};
